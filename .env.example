# Copy to .env.local (development) or set in your hosting dashboard (production).
# None of these are exposed to the browser except NEXT_PUBLIC_* values.

# Production origin, no trailing slash. Used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where form submissions are delivered (quote, contact, consultation, callback).
# Any endpoint that accepts a JSON POST: your backend, CRM, Zapier/Make webhook, email service, etc.
FORM_WEBHOOK_URL=
# Optional shared secret, sent as "Authorization: Bearer <secret>".
FORM_WEBHOOK_SECRET=

# true = accept and log submissions without a webhook (demos only). Leave unset in production.
FORMS_DEMO_MODE=
